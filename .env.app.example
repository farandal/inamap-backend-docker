# ----------------------------------------------------------------------------
# Env de Laravel para INAMAP (local). Copie a `.env.app.local`.
# `./inamap.sh init` lo genera con APP_KEY, contraseñas y claves de Reverb
# nuevas. Nunca comparta este archivo ni lo suba a git.
# ----------------------------------------------------------------------------
APP_NAME=INAMAP
APP_ENV=local
APP_KEY=
APP_CIPHER=AES-256-CBC
APP_DEBUG=true
APP_URL=http://localhost:25200
APP_PORT=25200
APP_MAIL_ENABLED=true
SERVER_NAME=localhost
PROJECT_NAME=inamap
PROJECT_DOMAIN=
API_THROTTLE_RATE=1000

# Usuarios creados por `php artisan db:seed` (solo desarrollo).
SYSTEM_ADMIN_EMAIL=admin@inamap.local
SYSTEM_ADMIN_PASSWORD=
DEFAULT_TENANT_NAME=inamap-demo
DEFAULT_TENANT_PUBLIC_ID=00.000.000-0
TENANT_ADMIN_EMAIL=tenant@inamap.local
TENANT_ADMIN_PASSWORD=
NORMAL_USER_EMAIL=user@inamap.local
NORMAL_USER_PASSWORD=
SKIP_EMAIL_VERIFICATION=true

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=pgsql
DB_PORT=5432
DB_DATABASE=im_dev_db
DB_DATABASE_TEST=im_dev_db_test
DB_USERNAME=im
DB_PASSWORD=

QUEUE_CONNECTION=redis
BROADCAST_DRIVER=reverb
CACHE_DRIVER=redis
FILESYSTEM_DISK=local
MEDIA_DISK=local
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_CLIENT=predis
REDIS_PREFIX=inamap_

# Reverb (websockets). REVERB_SERVER_PORT es el puerto dentro del contenedor;
# REVERB_PORT el que usan los navegadores (= REVERB_PUBLIC_PORT del .env).
REVERB_SERVER=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
REVERB_HOST=localhost
REVERB_PORT=27001
REVERB_SCHEME=http
REVERB_APPS_DRIVER=redis
REVERB_APPS_REDIS_CONNECTION=default
REVERB_APPS_REDIS_PREFIX=reverb:apps
REVERB_APP_PING_INTERVAL=60
REVERB_APP_ACTIVITY_TIMEOUT=30
REVERB_APP_MAX_MESSAGE_SIZE=65536
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_PORT=27001
PUSHER_APP_SCHEME=http
PUSHER_APP_CLUSTER=mt1

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@inamap.local
MAIL_FROM_NAME=INAMAP

# URL del panel (inamap-web) usada en correos y verificaciones.
FRONTEND_URL=http://localhost:5181

# --- INAMAP ---
# URL base del visor público (inamap-app): destino de QR y enlaces /inamap/{id}.
INAMAP_APP_URL=http://localhost:5180
INAMAP_SNAP_TOLERANCE_M=0.30
INAMAP_PUBLIC_RATE_LIMIT=120
INAMAP_SESSION_RATE_LIMIT=20

# Credenciales de terceros: solo si se usan.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
