# ----------------------------------------------------------------------------
# INAMAP — Cloudflare Tunnel (desarrollo público). Copie a `.env.tunnel`.
# Lo lee scripts/cloudflare-tunnel.js de ../dash-backend-docker. No va a git.
#
#   api-dev.inamap.space  →  API    (APP_PORT)
#   ws-dev.inamap.space   →  Reverb (REVERB_PUBLIC_PORT)
# ----------------------------------------------------------------------------

# Token de API con permisos Tunnel:Edit (cuenta) y DNS:Edit (zona inamap.space).
CF_API_TOKEN=
CF_ACCOUNT_ID=
CF_ZONE_NAME=inamap.space
CF_ZONE_ID=

# Túnel con nombre propio; si CF_TUNNEL_TOKEN queda vacío el script lo crea y lo guarda aquí.
CF_TUNNEL_NAME=inamap-dev
CF_TUNNEL_TOKEN=

# Deben coincidir con APP_PORT y REVERB_PUBLIC_PORT de .env.
CF_TUNNEL_HOSTNAME_API=api-dev.inamap.space
CF_TUNNEL_LOCAL_API=http://localhost:25200

CF_TUNNEL_HOSTNAME_WS=ws-dev.inamap.space
CF_TUNNEL_LOCAL_WS=http://localhost:27001
