# ----------------------------------------------------------------------------
# Variables de Docker Compose para INAMAP. Copie a `.env` y complete.
# Compose lee `.env` automáticamente: no hace falta --env-file.
# ----------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=inamap

# Imagen del core DASHADMIN. Use un tag fijo y publicado (nunca :latest en
# entornos compartidos). El equipo del core la entrega.
DASH_IMAGE=farandal/dash-backend:<tag>-core

# Env de Laravel montado en el contenedor (copie .env.app.example).
APP_ENV_FILE=./.env.app.local

# Repositorio del dominio, como carpeta hermana.
DOMAIN_PATH=../inamap-backend-domain

# Base de datos — deben coincidir con DB_* del env de Laravel.
DB_DATABASE=im_dev_db
DB_DATABASE_TEST=im_dev_db_test
DB_USERNAME=im
DB_PASSWORD=

# Puertos del host (bloque propio de INAMAP).
APP_PORT=25200
REVERB_PUBLIC_PORT=27001
DB_FORWARD_PORT=25434
REDIS_FORWARD_PORT=25389
MAILHOG_SMTP_PORT=25029
MAILHOG_UI_PORT=25030

# Solo con docker-compose.core-dev.yml (desarrolladores del core).
CORE_PATH=../dash-backend
